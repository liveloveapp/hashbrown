{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "commonjs",
    "moduleResolution": "node10",
    "types": ["node"],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "all.playwright.config.ts",
    "conformance.playwright.config.ts",
    "provider.playwright.config.ts",
    "harness/**/*.ts",
    "specs/**/*.ts",
    "provider/native-ui.spec.ts",
    "local-models.playwright.config.ts",
    "local-models/**/*.ts",
    "local-provider.playwright.config.ts"
  ],
  "exclude": ["harness/**/*.spec.ts"]
}
