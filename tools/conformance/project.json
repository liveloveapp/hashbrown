{
  "name": "conformance",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "tools/conformance",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          "tsc --noEmit -p tools/conformance/tsconfig.playwright.json",
          "tsc --noEmit -p tools/conformance/tsconfig.spec.json"
        ]
      },
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/eslint.config.mjs"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint tools/conformance --ignore-pattern 'tools/conformance/hosts/**' --ignore-pattern 'tools/conformance/dotnet/**'"
      },
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/eslint.config.mjs"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/tools/conformance"],
      "options": {
        "jestConfig": "tools/conformance/jest.config.ts",
        "passWithNoTests": false
      },
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/eslint.config.mjs"
      ],
      "dependsOn": ["agent-framework-harness-test", "agent-framework-test"]
    },
    "conformance-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/conformance.playwright.config.ts"
      }
    },
    "provider-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/provider.playwright.config.ts"
      }
    },
    "example-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/all.playwright.config.ts"
      }
    },
    "local-model-contract-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-models.playwright.config.ts"
      }
    },
    "local-model-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-models.playwright.config.ts",
        "env": {
          "LOCAL_LLM_NATIVE": "1"
        }
      }
    },
    "local-webllm-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-models.playwright.config.ts",
        "env": {
          "LOCAL_LLM_WEBLLM": "1"
        }
      }
    },
    "local-provider-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "playwright test --config tools/conformance/local-provider.playwright.config.ts"
      }
    },
    "local-native-capability-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-models.playwright.config.ts --grep=\"native runtime capabilities\"",
        "env": {
          "LOCAL_LLM_NATIVE": "1",
          "LOCAL_LLM_CAPABILITIES": "1"
        }
      }
    },
    "local-media-contract-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-media.playwright.config.ts",
        "env": {
          "LOCAL_LLM_AUDIO": "1"
        }
      }
    },
    "local-media-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-media.playwright.config.ts",
        "env": {
          "LOCAL_LLM_MEDIA_NATIVE": "1",
          "LOCAL_LLM_AUDIO": "1"
        }
      }
    },
    "local-native-audio-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-models.playwright.config.ts --grep=\"native runtime transcribes generated speech\"",
        "env": {
          "LOCAL_LLM_NATIVE": "1",
          "LOCAL_LLM_AUDIO": "1"
        }
      }
    },
    "local-provider-workflow-contract-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-workflows.playwright.config.ts"
      }
    },
    "local-provider-workflow-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-workflows.playwright.config.ts",
        "env": {
          "LOCAL_LLM_WORKFLOWS_LIVE": "1"
        }
      }
    },
    "local-native-tool-roundtrip-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-models.playwright.config.ts",
        "env": {
          "LOCAL_LLM_NATIVE_TOOL_ROUNDTRIP": "1"
        }
      }
    },
    "local-native-tool-capability-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-models.playwright.config.ts",
        "env": {
          "LOCAL_LLM_NATIVE_TOOLS": "1"
        }
      }
    },
    "local-native-tool-contract-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-native-tools.playwright.config.ts"
      }
    },
    "local-native-tool-workflow-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-native-tools.playwright.config.ts",
        "env": {
          "LOCAL_LLM_NATIVE_TOOL_WORKFLOWS_LIVE": "1"
        }
      }
    },
    "local-native-schema-contract-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-native-schema.playwright.config.ts"
      }
    },
    "local-native-schema-workflow-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-native-schema.playwright.config.ts",
        "env": {
          "LOCAL_LLM_NATIVE_TOOL_WORKFLOWS_LIVE": "1"
        }
      }
    },
    "local-native-ui-contract-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
