      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-native-ui.playwright.config.ts",
        "env": {
          "LOCAL_LLM_NATIVE_TOOL_WORKFLOWS_LIVE": "1"
        }
      }
    },
    "local-native-ui-phase-contract-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-native-ui-phases.playwright.config.ts",
        "env": {
          "LOCAL_LLM_APPLICATION_TOOL_PHASES": "1"
        }
      }
    },
    "local-native-ui-phase-workflow-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-native-ui-phases.playwright.config.ts",
        "env": {
          "LOCAL_LLM_NATIVE_TOOL_WORKFLOWS_LIVE": "1",
          "LOCAL_LLM_APPLICATION_TOOL_PHASES": "1"
        }
      }
    },
    "local-webllm-tool-contract-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-webllm-tools.playwright.config.ts"
      }
    },
    "local-webllm-image-contract-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-webllm-images.playwright.config.ts"
      }
    },
    "local-webllm-vision-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-webllm-vision.playwright.config.ts"
      }
    },
    "local-webllm-tools-live": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/local-webllm-tools-live.playwright.config.ts"
      }
    },
    "agent-framework-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/conformance.playwright.config.ts agent-framework-display.spec.ts"
      }
    },
    "agent-framework-harness-test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tools/conformance/agent-frameworks/node/capture.mjs"
      ],
      "options": {
        "command": "node --test tools/conformance/agent-frameworks/harness/*.spec.mjs"
      }
    },
    "agent-framework-install": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "parallel": false,
        "commands": [
          "npm ci --prefix tools/conformance/agent-frameworks/node --ignore-scripts --no-audit --no-fund",
          "npm ls --all --prefix tools/conformance/agent-frameworks/node"
        ]
      }
    },
    "agent-framework-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["agent-framework-install"],
      "options": {
        "parallel": false,
        "commands": [
          "node --test tools/conformance/agent-frameworks/node/*.spec.mjs",
          "node tools/conformance/agent-frameworks/generate.mjs --check"
        ]
      }
    },
    "agent-framework-capture": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["agent-framework-install"],
      "options": {
        "command": "node tools/conformance/agent-frameworks/generate.mjs --write"
      }
    }
  },
  "implicitDependencies": [
    "core",
    "angular",
    "react",
    "testing",
    "openai",
    "runtime-smoke-angular",
    "runtime-smoke-react",
    "ollama",
    "hashbrown-agent-framework-conformance"
  ]
}
