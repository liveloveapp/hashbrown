{
  "name": "dotnet-conformance",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "tools/conformance/dotnet",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/.github/workflows/pr-main.yml",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/www/content/docs/react/platform/dotnet.md",
      "{workspaceRoot}/www/content/docs/angular/platform/dotnet.md",
      "{workspaceRoot}/www/content/docs/react/platform/dotnet-native-tools.md",
      "{workspaceRoot}/www/content/docs/angular/platform/dotnet-native-tools.md",
      "{workspaceRoot}/packages/dotnet/**/*"
    ],
    "sourceTests": [
      "default",
      "{workspaceRoot}/packages/core/**/*",
      "{workspaceRoot}/tools/conformance/hosts/{react,angular}/src/recovery.ts",
      "{workspaceRoot}/tools/conformance/harness/{app-driver,event-gate}.ts",
      "{workspaceRoot}/.github/workflows/nightly.yml",
      "{workspaceRoot}/www/test/rehype-shiki.spec.ts",
      "{workspaceRoot}/LICENSE",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/jest.preset.js",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/.nvmrc",
      "{workspaceRoot}/packages/dotnet/.gitignore"
    ],
    "suiteTooling": [
      "{projectRoot}/project.json",
      "{projectRoot}/test-suites.ts",
      "{projectRoot}/jest.config.ts",
      "{projectRoot}/tsconfig.spec.json",
      "{projectRoot}/harness/**/*.ts",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/jest.preset.js",
      "{workspaceRoot}/.nvmrc"
    ],
    "candidateConsumer": [
      "default",
      "{workspaceRoot}/packages/{core,react,angular}/**/*",
      "{workspaceRoot}/tools/growth/install/**/*",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/tsconfig*.json"
    ],
    "harnessTests": [
      "{projectRoot}/tests/candidate-ci.spec.ts",
      "{projectRoot}/tests/candidate-browser-evidence.spec.ts",
      "{projectRoot}/tests/candidate-browser-process.spec.ts",
      "{projectRoot}/tests/candidate-recovery-controls.spec.ts",
      "{projectRoot}/tests/candidate-browser-manifest.spec.ts",
      "{projectRoot}/tests/candidate-deadline-transport.spec.ts",
      "{projectRoot}/tests/candidate-browser-recovery.spec.ts",
      "{projectRoot}/tests/candidate-consumer.spec.ts",
      "{projectRoot}/tests/candidate-handler-observer.spec.ts",
      "{projectRoot}/tests/candidate-recovery-proxy.spec.ts",
      "{projectRoot}/candidate-consumer/*.mjs",
      "{projectRoot}/tests/published-recovery-baseline.spec.ts",
      "suiteTooling",
      "{projectRoot}/jest.harness.config.ts",
      "{projectRoot}/tests/fixtures/**/*.ts",
      "{projectRoot}/tests/live-browser-fixture.spec.ts",
      "{projectRoot}/tests/live-budget.spec.ts",
      "{projectRoot}/tests/live-configuration.spec.ts",
      "{projectRoot}/tests/live-diagnostics.spec.ts",
      "{projectRoot}/tests/live-failure-phase.spec.ts",
      "{projectRoot}/tests/live-native-approval.spec.ts",
      "{projectRoot}/tests/live-native-stage.spec.ts",
      "{projectRoot}/tests/live-wait-policy.spec.ts",
      "{projectRoot}/tests/local-native-approval-browser.spec.ts",
      "{projectRoot}/tests/recovery-timings.spec.ts",
      "{projectRoot}/tests/routed-endpoint.spec.ts",
      "{projectRoot}/tests/stable-model-router.spec.ts",
      "{projectRoot}/tests/terminate-fixture.spec.ts",
      "{projectRoot}/tests/wait-for-native-recovery.spec.ts",
      "{projectRoot}/nuget-consumer/published-recovery-baseline.mjs",
      "{projectRoot}/nuget-consumer/recovery-upgrade-runner.mjs",
      "{projectRoot}/published-baselines/**/*",
      "{projectRoot}/candidate-recovery.playwright.config.ts",
      "{projectRoot}/candidate-specs/**/*.ts",
      "{projectRoot}/harness/candidate-browser-journeys.ts",
      "{projectRoot}/harness/candidate-browser-observer-control.ts",
      "{projectRoot}/tests/candidate-browser-acceptance.spec.ts",
      "{projectRoot}/harness/candidate-browser-acceptance.ts"
    ],
    "runtimeTests": [
      "{projectRoot}/tests/candidate-native-evidence.spec.ts",
      "{projectRoot}/tests/candidate-split-producer.spec.ts",
      "{projectRoot}/tests/candidate-native-text-transition.spec.ts",
      "{projectRoot}/tests/fixtures/candidate-native-text-transition.cs.txt",
      "suiteTooling",
      "{projectRoot}/jest.runtime.config.ts",
      "{projectRoot}/**/*.cs",
      "{projectRoot}/**/*.csproj",
      "{projectRoot}/**/*.props",
      "{projectRoot}/**/*.targets",
      "{projectRoot}/global.json",
      "{projectRoot}/nuget.config",
      "{projectRoot}/packages.lock.json",
      "{projectRoot}/tests/fixtures/**/*",
      "{projectRoot}/nuget-consumer/role-shape.cjs",
      "{projectRoot}/nuget-consumer/role-shape.d.cts",
      "{workspaceRoot}/packages/dotnet/**/*",
      "{workspaceRoot}/packages/core/**/*",
      "{workspaceRoot}/tools/conformance/hosts/{react,angular}/src/recovery.ts",
      "{workspaceRoot}/tools/conformance/harness/{app-driver,event-gate}.ts",
      "{projectRoot}/tests/browser-tool-schema.spec.ts",
      "{projectRoot}/tests/durable-interrupts.spec.ts",
      "{projectRoot}/tests/endpoint-registration.spec.ts",
      "{projectRoot}/tests/feasibility.spec.ts",
      "{projectRoot}/tests/interrupt-resume.spec.ts",
      "{projectRoot}/tests/live-approval-journal.spec.ts",
      "{projectRoot}/tests/live-fixture.spec.ts",
      "{projectRoot}/tests/native-approval-adapter.spec.ts",
      "{projectRoot}/tests/native-approval-admission-order.spec.ts",
      "{projectRoot}/tests/native-approval-admission.spec.ts",
      "{projectRoot}/tests/native-approval-decisions.spec.ts",
      "{projectRoot}/tests/native-approval-durability.spec.ts",
      "{projectRoot}/tests/native-approval-host.spec.ts",
      "{projectRoot}/tests/native-approval-publication.spec.ts",
      "{projectRoot}/tests/native-approval-store.spec.ts",
      "{projectRoot}/tests/native-browser-recovery-admission.spec.ts",
      "{projectRoot}/tests/native-browser-recovery-durability.spec.ts",
      "{projectRoot}/tests/native-browser-recovery-store.spec.ts",
      "{projectRoot}/tests/native-browser-recovery-wire.spec.ts",
      "{projectRoot}/tests/native-browser-recovery-results.spec.ts",
      "{projectRoot}/tests/native-browser-recovery-held-results.spec.ts",
      "{projectRoot}/tests/native-completed-history-projection.spec.ts",
      "{projectRoot}/tests/native-recovered-provider-input.spec.ts",
      "{projectRoot}/tests/native-recovery-client.spec.ts",
      "{projectRoot}/tests/native-session-durability.spec.ts",
      "{projectRoot}/tests/native-session-host.spec.ts",
      "{projectRoot}/tests/native-session-projection.spec.ts",
      "{projectRoot}/tests/native-session-store.spec.ts",
      "{projectRoot}/tests/pending-interrupts.spec.ts",
      "{projectRoot}/tests/provider-authentication.spec.ts",
      "{projectRoot}/tests/recovery-observer.spec.ts",
      "{projectRoot}/tests/recovery-store-validation.spec.ts",
      "{projectRoot}/tests/recovery.spec.ts",
      "{projectRoot}/tests/request-contract.spec.ts",
      "{projectRoot}/tests/responses-contract.spec.ts",
      "{projectRoot}/tests/responses-recovery-evidence.spec.ts",
      "{projectRoot}/tests/responses-recovery-native.spec.ts",
      "{projectRoot}/tests/retention.spec.ts",
      "{projectRoot}/tests/server-identity.spec.ts",
      "{projectRoot}/tests/stateless-responses.spec.ts",
      "{projectRoot}/tests/tools.spec.ts"
    ],
    "recoveryCompatibilityTests": [
      "suiteTooling",
      "{projectRoot}/jest.recovery-compatibility.config.ts",
      "{projectRoot}/tests/native-browser-recovery-compatibility.spec.ts",
      "{projectRoot}/nuget-consumer/*.mjs",
      "{projectRoot}/published-baselines/**/*"
    ]
  },
  "implicitDependencies": [
    "core",
    "react",
    "angular",
    "testing",
    "conformance",
    "runtime-smoke-react",
    "runtime-smoke-angular",
    "dotnet-sdk"
  ],
  "targets": {
    "prepare-candidate-npm": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["candidateConsumer"],
      "options": {
        "command": "node tools/conformance/dotnet/candidate-consumer/prepare.mjs npm"
      }
    },
    "prepare-candidate-nuget": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["candidateConsumer"],
      "options": {
        "command": "node tools/conformance/dotnet/candidate-consumer/prepare.mjs nuget"
      }
    },
    "candidate-consumer-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["candidateConsumer"],
      "options": {
        "command": "node tools/conformance/dotnet/candidate-consumer/check.mjs"
      }
    },
    "restore-lock": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "tools/conformance/dotnet",
        "command": "dotnet restore --use-lock-file"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/tools/conformance/dotnet"],
      "options": {
        "cwd": "tools/conformance/dotnet",
        "parallel": false,
        "commands": [
          "dotnet build --no-restore -c Release -o ../../../dist/tools/conformance/dotnet",
          "tsc --noEmit -p tsconfig.spec.json",
          "tsc --noEmit -p tsconfig.playwright.json"
        ]
      },
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/jest.preset.js",
        "{projectRoot}/harness/terminate-fixture.ts",
        {
          "runtime": "dotnet --version"
        },
        {
          "env": "DOTNET_TEST_POSTGRES"
        }
      ],
      "dependsOn": ["restore"]
    },
    "test": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": ["test-harness", "test-runtime", "test-package"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "tools/conformance/dotnet",
        "forwardAllArgs": false,
        "parallel": false,
        "commands": [
          "dotnet format --verify-no-changes --no-restore",
          "eslint harness/candidate-handler-observer.ts harness/candidate-recovery-proxy.ts tests/candidate-handler-observer.spec.ts tests/candidate-recovery-proxy.spec.ts harness/candidate-browser-manifest.ts harness/candidate-browser-reporter.ts candidate-recovery.playwright.config.ts candidate-specs/browser-recovery.spec.ts harness/candidate-browser-recovery.ts harness/candidate-browser-journeys.ts harness/candidate-browser-acceptance.ts harness/candidate-browser-observer-control.ts harness/candidate-browser-evidence.ts tests/candidate-browser-evidence.spec.ts tests/candidate-browser-acceptance.spec.ts tests/candidate-browser-process.spec.ts",
          "prettier --check harness/candidate-handler-observer.ts harness/candidate-recovery-proxy.ts tests/candidate-handler-observer.spec.ts tests/candidate-recovery-proxy.spec.ts harness/candidate-browser-manifest.ts harness/candidate-browser-reporter.ts candidate-recovery.playwright.config.ts candidate-specs/browser-recovery.spec.ts harness/candidate-browser-recovery.ts harness/candidate-browser-journeys.ts harness/candidate-browser-acceptance.ts harness/candidate-browser-observer-control.ts harness/candidate-browser-evidence.ts tests/candidate-browser-evidence.spec.ts tests/candidate-browser-acceptance.spec.ts tests/candidate-browser-process.spec.ts",
          "eslint candidate-consumer/*.mjs candidate-consumer/templates/**/*.{ts,tsx} tests/candidate-browser-recovery.spec.ts tests/candidate-consumer.spec.ts tests/candidate-deadline-transport.spec.ts tests/candidate-browser-manifest.spec.ts tests/candidate-recovery-controls.spec.ts tests/candidate-ci.spec.ts",
          "prettier --check candidate-consumer/*.mjs candidate-consumer/templates/**/*.{ts,tsx} tests/candidate-browser-recovery.spec.ts tests/candidate-consumer.spec.ts tests/candidate-deadline-transport.spec.ts tests/candidate-browser-manifest.spec.ts tests/candidate-recovery-controls.spec.ts tests/candidate-ci.spec.ts",
          "eslint tests/fixtures/owned-package-host.ts tests/fixtures/package-live-worker.ts harness/live-package.ts harness/live-fixture.ts harness/live-runner.ts harness/live-diagnostics.ts tests/live-runner.spec.ts tests/live-fixture.spec.ts tests/live-diagnostics.spec.ts harness/terminate-fixture.ts harness/wait-for-native-recovery.ts harness/browser-smoke-selection.ts tests/terminate-fixture.spec.ts tests/wait-for-native-recovery.spec.ts tests/browser-smoke-selection.spec.ts smoke.playwright.config.ts package-smoke.playwright.config.ts",
          "eslint verify-recipe.mjs verify-native-recipe.mjs native-recipe.test.mjs nuget-consumer/*.mjs nuget-consumer/*.cjs nuget-consumer/*.d.cts harness/dotnet-host.ts harness/package-reporter.ts harness/http-fixture.ts harness/durable-fixture.ts harness/browser-fixture.ts harness/local-native-approval-browser.ts local-specs/native-approval.spec.ts tests/dotnet-host.spec.ts tests/package-identities.spec.ts tests/package-upgrade.spec.ts tests/nuget-consumer.spec.ts package.playwright.config.ts local-native-approval.playwright.config.ts dotnet.playwright.config.ts jest.config.ts jest.harness.config.ts jest.runtime.config.ts jest.package.config.ts jest.recovery-compatibility.config.ts test-suites.ts tests/native-browser-recovery-admission.spec.ts tests/native-browser-recovery-durability.spec.ts tests/native-browser-recovery-compatibility.spec.ts tests/native-browser-recovery-store.spec.ts tests/native-browser-recovery-wire.spec.ts tests/native-browser-recovery-results.spec.ts tests/native-browser-recovery-held-results.spec.ts tests/native-completed-history-projection.spec.ts tests/native-session-projection.spec.ts tests/native-recovered-provider-input.spec.ts tests/published-recovery-baseline.spec.ts tests/candidate-native-evidence.spec.ts tests/candidate-split-producer.spec.ts tests/candidate-native-text-transition.spec.ts",
          "prettier --check verify-recipe.mjs verify-native-recipe.mjs native-recipe.test.mjs \"nuget-consumer/*.{mjs,cjs,cts}\" harness/dotnet-host.ts harness/package-reporter.ts harness/http-fixture.ts harness/durable-fixture.ts harness/browser-fixture.ts harness/local-native-approval-browser.ts local-specs/native-approval.spec.ts tests/dotnet-host.spec.ts tests/package-identities.spec.ts tests/package-upgrade.spec.ts tests/nuget-consumer.spec.ts package.playwright.config.ts local-native-approval.playwright.config.ts dotnet.playwright.config.ts jest.config.ts jest.harness.config.ts jest.runtime.config.ts jest.package.config.ts jest.recovery-compatibility.config.ts test-suites.ts tests/native-browser-recovery-admission.spec.ts tests/native-browser-recovery-durability.spec.ts tests/native-browser-recovery-compatibility.spec.ts tests/native-browser-recovery-store.spec.ts tests/native-browser-recovery-wire.spec.ts tests/native-browser-recovery-results.spec.ts tests/native-browser-recovery-held-results.spec.ts tests/native-completed-history-projection.spec.ts tests/native-session-projection.spec.ts tests/native-recovered-provider-input.spec.ts tests/published-recovery-baseline.spec.ts tests/candidate-native-evidence.spec.ts tests/candidate-split-producer.spec.ts tests/candidate-native-text-transition.spec.ts"
        ]
      },
      "dependsOn": ["build"],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/jest.preset.js",
        "{projectRoot}/harness/terminate-fixture.ts",
        {
          "runtime": "dotnet --version"
        },
        {
          "env": "DOTNET_TEST_POSTGRES"
        },
        "{workspaceRoot}/eslint.config.mjs"
      ]
    },
    "provider-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build",
        {
          "projects": ["runtime-smoke-react", "runtime-smoke-angular"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/dotnet/dotnet.playwright.config.ts"
      }
    },
    "check-docs": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/jest.preset.js",
        "{projectRoot}/harness/terminate-fixture.ts",
        {
          "runtime": "dotnet --version"
        },
        {
          "env": "DOTNET_TEST_POSTGRES"
        }
      ],
      "dependsOn": ["build"],
      "options": {
        "command": "node tools/conformance/dotnet/verify-recipe.mjs --all"
      }
    },
    "prepare-live-consumer": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/conformance/dotnet/live-consumer/prepare.mjs"
      }
    },
    "live-provider-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx tools/conformance/dotnet/harness/live-runner.ts"
      }
    },
    "local-native-approval-browser": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx tools/conformance/dotnet/nuget-consumer/browser-runner.mjs --regressions"
      }
    },
    "package-prepare": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/conformance/dotnet/nuget-consumer/prepare.mjs"
      }
    },
    "package-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx tools/conformance/dotnet/nuget-consumer/browser-runner.mjs"
      }
    },
    "package-upgrade": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/conformance/dotnet/nuget-consumer/upgrade-runner.mjs"
      }
    },
    "package-acceptance": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^default"],
      "options": {
        "command": "node tools/conformance/dotnet/nuget-consumer/run.mjs"
      }
    },
    "provider-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build",
        {
          "projects": ["runtime-smoke-react", "runtime-smoke-angular"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config tools/conformance/dotnet/smoke.playwright.config.ts"
      }
    },
    "restore": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["dotnet-sdk"],
          "target": "build"
        }
      ],
      "options": {
        "cwd": "tools/conformance/dotnet",
        "command": "dotnet restore --locked-mode"
      }
    },
    "package-pr-acceptance": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^default"],
      "options": {
        "command": "node tools/conformance/dotnet/nuget-consumer/run.mjs --pr"
      }
    },
    "test-harness": {
      "executor": "@nx/jest:jest",
      "cache": true,
      "dependsOn": [],
      "options": {
        "jestConfig": "tools/conformance/dotnet/jest.harness.config.ts",
        "runInBand": true
      },
      "inputs": [
        "harnessTests",
        {
          "runtime": "dotnet --version"
        },
        {
          "runtime": "node --version"
        },
        {
          "runtime": "node -p \"process.platform + '-' + process.arch\""
        },
        {
          "env": "DOTNET_TEST_POSTGRES"
        },
        {
          "env": "HASHBROWN_DOTNET_HOST_MODE"
        }
      ]
    },
    "test-runtime": {
      "executor": "@nx/jest:jest",
      "cache": true,
      "dependsOn": ["build"],
      "options": {
        "jestConfig": "tools/conformance/dotnet/jest.runtime.config.ts",
        "runInBand": true
      },
      "inputs": [
        "runtimeTests",
        {
          "runtime": "dotnet --version"
        },
        {
          "runtime": "node --version"
        },
        {
          "runtime": "node -p \"process.platform + '-' + process.arch\""
        },
        {
          "env": "DOTNET_TEST_POSTGRES"
        },
        {
          "env": "HASHBROWN_DOTNET_HOST_MODE"
        }
      ]
    },
    "test-package": {
      "executor": "@nx/jest:jest",
      "cache": true,
      "dependsOn": ["test-runtime"],
      "options": {
        "jestConfig": "tools/conformance/dotnet/jest.package.config.ts",
        "runInBand": true
      },
      "inputs": [
        "sourceTests",
        {
          "runtime": "dotnet --version"
        },
        {
          "runtime": "node --version"
        },
        {
          "runtime": "node -p \"process.platform + '-' + process.arch\""
        },
        {
          "env": "DOTNET_TEST_POSTGRES"
        },
        {
          "env": "HASHBROWN_DOTNET_HOST_MODE"
        }
      ]
    },
    "test-recovery-compatibility": {
      "executor": "@nx/jest:jest",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "jestConfig": "tools/conformance/dotnet/jest.recovery-compatibility.config.ts",
        "runInBand": true
      },
      "inputs": ["recoveryCompatibilityTests"]
    },
    "candidate-recovery-browser-pilot": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["candidateConsumer"],
      "options": {
        "command": "node tools/conformance/dotnet/candidate-consumer/browser-runner.mjs pilot"
      }
    },
    "candidate-recovery-browser": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["candidateConsumer"],
      "options": {
        "command": "node tools/conformance/dotnet/candidate-consumer/browser-runner.mjs all"
      }
    }
  }
}
