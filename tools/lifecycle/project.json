{
  "name": "lifecycle",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/lifecycle/src",
  "projectType": "application",
  "tags": [],
  "implicitDependencies": ["growth"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint tools/lifecycle",
        "forwardAllArgs": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config tools/lifecycle/vitest.config.mts"
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config tools/lifecycle/vitest.integration.config.mts --reporter=verbose"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "parallel": false,
        "commands": [
          "node --import tsx tools/lifecycle/scripts/b4-cli.mts check",
          "tsc --noEmit -p tools/lifecycle/tsconfig.json",
          "tsc --noEmit -p tools/lifecycle/tsconfig.spec.json"
        ]
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{projectRoot}/.b4/build", "{projectRoot}/.vercel/output"],
      "options": {
        "parallel": false,
        "commands": [
          "tsc --noEmit -p tools/lifecycle/tsconfig.json",
          "tsc --noEmit -p tools/lifecycle/tsconfig.spec.json",
          "node --import tsx tools/lifecycle/scripts/b4-cli.mts build --clean",
          "node --import tsx tools/lifecycle/scripts/verify-vercel-adapter.mts"
        ]
      },
      "configurations": {
        "production": {}
      }
    }
  }
}
