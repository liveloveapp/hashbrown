{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "commonjs",
    "moduleResolution": "node10",
    "types": ["node"],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "*playwright.config.ts",
    "harness/**/*.ts",
    "specs/**/*.ts",
    "example-specs/**/*.ts"
  ],
  "exclude": ["harness/**/*.spec.ts"]
}
