{
  "name": "workbench",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["www"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["www"], "target": "workbench-build" }],
      "outputs": ["{projectRoot}/.vercel/output"],
      "options": {
        "command": "tsx tools/workbench/build-vercel-output.mts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "node --test tools/workbench/*.test.mjs" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint tools/workbench" }
    }
  }
}
