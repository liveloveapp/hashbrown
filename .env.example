# Providers
ANTHROPIC_API_KEY=test-key
AZURE_API_KEY=test-key
AZURE_ENDPOINT=url
AZURE_API_VERSION=version
GOOGLE_API_KEY=test-key
OPENAI_API_KEY=test-key
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=model-id

# Growth provisioning (tools/growth/scripts/provision)
# Put these in the repo-root .env (gitignored) and run
#   node tools/growth/scripts/provision/index.mjs --env-file .env
# or point --env-file at any private file.
# POSTHOG_PERSONAL_API_KEY=
# RESEND_PROVISION_API_KEY=
# VERCEL_API_TOKEN=
# FOUNDER_NOTIFICATION_EMAIL=

# Growth control plane (tools/growth)
# DATABASE_URL=                          # set by the Vercel Neon integration on deployments; locally use `vercel env pull` or the preview store for migrations
# GROWTH_DATABASE_ENVIRONMENT=           # production | preview | test; must match DELIVERY_ENVIRONMENT
# DELIVERY_ENVIRONMENT=                  # production | preview | test; environment this deployment sends from; the sender refuses unless it equals GROWTH_DATABASE_ENVIRONMENT (enforced on the delivery policy object the caller builds from these variables, PR 5)
# GROWTH_EMAIL_HMAC_ACTIVE_SECRET=       # secret that keys email hashes for new contacts
# GROWTH_EMAIL_HMAC_ACTIVE_VERSION=      # integer key version (1–32767) of the active email HMAC secret
# GROWTH_EMAIL_HMAC_PREVIOUS_KEYS=       # JSON array of {version, secret} for retired email HMAC keys
# GROWTH_ACTION_TOKEN_ACTIVE_SECRET=     # secret that signs unsubscribe and founder-stop tokens
# GROWTH_ACTION_TOKEN_ACTIVE_VERSION=    # integer key version (1–32767) of the active action-token secret
# GROWTH_ACTION_TOKEN_PREVIOUS_KEYS=     # JSON array of {version, secret} for retired action-token keys
# GROWTH_PUBLIC_ACTION_ORIGIN=           # bare https origin used to build action links, for example https://hashbrown.dev
# RESEND_API_KEY=                        # Resend sending key
# RESEND_WEBHOOK_SECRET=                 # Resend (Svix) webhook signing secret
# RESEND_INBOUND_WEBHOOK_SECRET=         # separate signing secret for email.received at /_/webhooks/resend-inbound
# RESEND_INBOX_READ_API_KEY=             # server-only receiving and sent Message-ID lookup credential; Resend requires full_access; distinct from sending key
# RESEND_INBOX_PILOT_ENABLED=            # true enables the Resend reply mailbox pilot; Gmail polling is retired
# RESEND_INBOX_PILOT_ADDRESS=            # brian@replies.hashbrown.dev; root-domain historical replies are not covered
# RESEND_INBOX_PILOT_ALLOW_ALL_RECIPIENTS= # true records an explicit canary waiver; mailbox/reply gates remain enforced
# RESEND_INBOX_PILOT_RECIPIENT_ALLOWLIST=  # comma list of operator-owned canary recipients when waiver flag is absent
# RESEND_INBOX_PILOT_STARTED_AT=         # immutable ISO timestamp of the pilot start; run inbox-recover before delivery
# GROWTH_COLLECTION_SOURCES=               # comma list of website,install,runtime; the collection route answers 503 collection_disabled for a source not listed
# GROWTH_OBSERVATION_PROCESSING_ENABLED= # true lets `observability process` run; the lifecycle tick runs it once LIFECYCLE_CRON_ENABLED=true
# RESEND_TRACKING_DISABLED=              # must be true; the sender refuses otherwise (via the delivery policy the caller builds, PR 5)
# RESEND_SENDER_VERIFIED=                # true once the sending domain is verified in Resend
# RESEND_NON_PRODUCTION_ALLOWLIST=       # comma-separated recipients allowed outside production
# RESEND_NON_PRODUCTION_REDIRECT_TO=     # optional address that receives all non-production mail
# TEST_DATABASE_URL=                     # integration specs only; written by provisioning into tools/growth/.provision/test-database.env
# GROWTH_INTEGRATION=                    # integration specs only: set to 1 to run them; DATABASE_URL must be unset

# Lifecycle service (tools/lifecycle; deployed as hashbrown-lifecycle)
# LIFECYCLE_SERVICE_SECRET=              # shared bearer; every path answers 401 without `Authorization: Bearer <secret>` and 503 when unset
# B4_DATABASE_URL=                       # b4run state store (threads, checkpoints, permissions); set by the Vercel Neon integration; never the growth DATABASE_URL
# B4_PG_SCHEMA=                          # optional Postgres schema for b4run tables
# B4_PG_TABLE_PREFIX=                    # optional table prefix for b4run tables
# CAMPAIGN_ENABLED=                      # true | false; unset is false
# CAMPAIGN_ENROLLMENT_ENABLED=           # true | false; unset is false; needs CAMPAIGN_ENROLLMENT_START_AT
# CAMPAIGN_ENROLLMENT_START_AT=          # YYYY-MM-DDTHH:MM:SS.mmmZ; set when enabling enrollment; immutable once recorded
# DELIVERY_ENABLED=                      # true | false; unset is false
# GROWTH_INSTALL_DIGEST_ENABLED=         # true | false; unset is false
# GROWTH_INSTALL_RUNTIME_HELLO_ENABLED=  # true | false; unset is false
# LIFECYCLE_BATCH_SIZE=                  # jobs leased per tick, 1..25; default 20
# FOUNDER_NOTIFICATION_EMAIL=            # receives founder notifications and the install digest
# LIFECYCLE_URL=                         # www only: the lifecycle deployment URL the cron and form nudges call
# LIFECYCLE_CRON_ENABLED=                # www only: true | false; unset is false
# GROWTH_UNSTUCK_FORM_ENABLED=           # www only: true | false; unset is false (the Get unstuck form shows the fallback and the route answers 503)

# Website analytics (PostHog; tools/posthog, www)
# NEXT_PUBLIC_POSTHOG_TOKEN=               # public project token; www sends no PostHog events without it
# NEXT_PUBLIC_POSTHOG_CAPTURE_LOCAL=       # true lets localhost send events to PostHog; leave unset normally
# NEXT_PUBLIC_GROWTH_COLLECTION=           # true turns the website collector on; set only after "website" is in GROWTH_COLLECTION_SOURCES
# POSTHOG_PERSONAL_API_KEY=                # personal API key for tools/posthog; write scopes for sync:apply and settings:apply
# POSTHOG_PERSONAL_API_KEY_READONLY=       # read-only key; CI maps it to POSTHOG_PERSONAL_API_KEY (Actions secret)
# POSTHOG_PROJECT_ID=                      # positive integer PostHog project id
# POSTHOG_HOST=                            # optional https API host; defaults to https://us.i.posthog.com
