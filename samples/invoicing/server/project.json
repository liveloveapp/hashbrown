{
  "name": "invoicing-server",
  "projectType": "application",
  "sourceRoot": "samples/invoicing/server/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p samples/invoicing/server/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config samples/invoicing/server/vitest.config.mts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint samples/invoicing/server"
      }
    }
  }
}
