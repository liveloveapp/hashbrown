{
  "name": "invoicing-e2e",
  "projectType": "application",
  "sourceRoot": "samples/invoicing/e2e",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p samples/invoicing/e2e/tsconfig.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint samples/invoicing/e2e"
      }
    },
    "live-model": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config samples/invoicing/e2e/playwright.config.ts"
      }
    },
    "example-e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config samples/invoicing/e2e/playwright.deterministic.config.ts"
      }
    }
  }
}
