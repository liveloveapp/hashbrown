{
  "name": "invoicing-e2e",
  "projectType": "application",
  "sourceRoot": "examples/invoicing/e2e",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": ["tsc --noEmit -p examples/invoicing/e2e/tsconfig.json"]
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint examples/invoicing/e2e"
      }
    },
    "live-model": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config examples/invoicing/e2e/playwright.config.ts"
      }
    },
    "record-answer": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "playwright test --config examples/invoicing/e2e/record-answer.config.ts"
      }
    },
    "stills": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "playwright test --config examples/invoicing/e2e/record-stills.config.ts"
      }
    },
    "walkthrough": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx --tsconfig examples/invoicing/e2e/tsconfig.json examples/invoicing/e2e/walkthrough/main.ts"
      }
    },
    "test-walkthrough": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config examples/invoicing/e2e/walkthrough/vitest.config.mts"
      }
    },
    "application-e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config examples/invoicing/e2e/playwright.deterministic.config.ts"
      },
      "cache": false
    },
    "perf-live": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config examples/invoicing/e2e/perf/perf.playwright.config.ts"
      }
    },
    "test-perf": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config examples/invoicing/e2e/perf/vitest.config.mts"
      }
    },
    "test-servers": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config examples/invoicing/e2e/local-servers.vitest.config.mts"
      }
    }
  },
  "implicitDependencies": ["core", "angular", "react", "testing", "openai"]
}
