{
  "name": "invoicing-e2e",
  "projectType": "application",
  "sourceRoot": "examples/invoicing/e2e",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          "tsc --noEmit -p examples/invoicing/e2e/tsconfig.json",
          "tsc --noEmit -p examples/invoicing/e2e/conformance/tsconfig.playwright.json",
          "tsc --noEmit -p examples/invoicing/e2e/conformance/tsconfig.spec.json"
        ]
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint examples/invoicing/e2e"
      }
    },
    "live-model": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config examples/invoicing/e2e/playwright.config.ts"
      }
    },
    "application-e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config examples/invoicing/e2e/playwright.deterministic.config.ts"
      },
      "cache": false
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/examples/invoicing/e2e/conformance"
      ],
      "options": {
        "jestConfig": "examples/invoicing/e2e/conformance/jest.config.ts",
        "passWithNoTests": false
      }
    },
    "conformance-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config examples/invoicing/e2e/conformance.playwright.config.ts"
      }
    },
    "example-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config examples/invoicing/e2e/all.playwright.config.ts"
      }
    },
    "provider-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["runtime-smoke-angular", "runtime-smoke-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config examples/invoicing/e2e/provider.playwright.config.ts"
      }
    }
  },
  "implicitDependencies": [
    "core",
    "angular",
    "react",
    "testing",
    "runtime-smoke-angular",
    "runtime-smoke-react",
    "openai"
  ]
}
