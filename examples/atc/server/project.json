{
  "name": "atc-server",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "examples/atc/server/src",
  "implicitDependencies": ["core", "openai", "typesafe", "atc-shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p examples/atc/server/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config examples/atc/server/vitest.config.mts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint examples/atc/server"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "tsx --tsconfig examples/atc/server/tsconfig.json examples/atc/server/src/main.ts"
      }
    },
    "prune-agent-state": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx --tsconfig examples/atc/server/tsconfig.json examples/atc/server/scripts/prune-agent-state.cts"
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config examples/atc/server/vitest.postgres.config.mts"
      }
    },
    "test-artifact": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx --tsconfig examples/atc/server/tsconfig.json examples/atc/tools/verify-agent-postgres.mts"
      }
    }
  }
}
