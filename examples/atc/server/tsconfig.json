{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noPropertyAccessFromIndexSignature": true,
    "types": ["node"],
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "vitest.config.mts",
    "agent/b4.config.ts",
    "scripts/**/*.cts",
    "../tools/*.mts"
  ]
}
