{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "types": ["node"],
    "noEmit": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.ts",
    "demo/**/*.ts",
    "prose/**/*.ts",
    "decide/**/*.ts",
    "playwright.config.ts"
  ]
}
