{
  "name": "atc-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["atc-angular", "atc-react", "atc-server"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["atc-angular", "atc-react"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config examples/atc/e2e/playwright.config.ts"
      }
    },
    "demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["atc-angular"],
          "target": "build"
        }
      ],
      "options": {
        "command": "tsx --tsconfig examples/atc/e2e/tsconfig.json examples/atc/e2e/demo/record.ts"
      }
    },
    "demo-publish": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx --tsconfig examples/atc/e2e/tsconfig.json examples/atc/e2e/demo/publish.ts"
      }
    },
    "prose-eval": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx --tsconfig examples/atc/e2e/tsconfig.json examples/atc/e2e/prose/eval.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config examples/atc/e2e/demo/vitest.config.mts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint examples/atc/e2e"
      }
    }
  }
}
