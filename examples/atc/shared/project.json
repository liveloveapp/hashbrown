{
  "name": "atc-shared",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "examples/atc/shared/src",
  "implicitDependencies": ["core"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p examples/atc/shared/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config examples/atc/shared/vitest.config.mts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint examples/atc/shared" }
    }
  }
}
