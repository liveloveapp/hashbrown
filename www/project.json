{
  "name": "www",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "www/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.next"],
      "options": {
        "command": "next build",
        "cwd": "www"
      },
      "dependsOn": [
        {
          "projects": ["openai"],
          "target": "build"
        },
        "collect-docs",
        "generate-llms"
      ]
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "next dev",
        "cwd": "www"
      },
      "dependsOn": [
        {
          "projects": ["openai"],
          "target": "build"
        },
        "collect-docs",
        "generate-llms"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config www/vitest.config.mts"
      },
      "dependsOn": ["collect-docs", "generate-llms"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint www/src www/test www/instrumentation-client.ts www/next.config.ts www/examples/quickstart www/examples/threadplane-consumers"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsx www/src/tools/route-report.ts",
          "tsx www/src/tools/mobile-layout-report.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["build", "workbench-e2e"]
    },
    "collect-docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx www/src/tools/extract-docs-content.ts"
      },
      "dependsOn": [
        {
          "projects": ["angular", "core", "react"],
          "target": "build"
        }
      ]
    },
    "generate-llms": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node www/src/tools/generate-llms.mjs --baseUrl=https://hashbrown.dev"
      }
    },
    "review-docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx www/src/tools/review-docs.ts"
      },
      "dependsOn": [
        {
          "projects": [
            "angular",
            "azure",
            "core",
            "google",
            "openai",
            "react",
            "typesafe"
          ],
          "target": "build-api-report"
        }
      ]
    },
    "translate-docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx www/src/tools/translate-docs.ts"
      },
      "dependsOn": [
        {
          "projects": [
            "angular",
            "azure",
            "core",
            "google",
            "openai",
            "react",
            "typesafe"
          ],
          "target": "build-api-report"
        }
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ngc -p www/examples/quickstart/tsconfig.json"
      },
      "dependsOn": [
        {
          "projects": ["core", "react", "angular", "openai", "typesafe"],
          "target": "build"
        }
      ]
    },
    "docs-demo": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-quickstart.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"],
      "cache": false
    },
    "docs-workflows-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-workflows.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "docs-structured-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-structured.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "docs-production-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-production.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "docs-recipes-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-recipes.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "docs-local-models-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-local-models.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "docs-request-transform-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-request-transform.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "docs-threadplane-prepare": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx www/src/tools/prepare-docs-threadplane.ts"
      }
    },
    "docs-threadplane-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx www/src/tools/record-docs-threadplane.ts"
      }
    },
    "docs-agent-decisions-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-agent-decisions.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "docs-ui-chatbot-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-light-chatbot.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "docs-parser-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-parser.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "workbench-build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/docs-workbench/browser",
        "{workspaceRoot}/dist/docs-workbench/node"
      ],
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/build-workbench.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "workbench-serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "node --env-file-if-exists=.env dist/docs-workbench/node/workbench-server.mjs"
      },
      "dependsOn": ["workbench-build"]
    },
    "workbench-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node dist/docs-workbench/node/verify-workbench.mjs"
      },
      "dependsOn": ["workbench-build"]
    },
    "workbench-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx www/src/tools/record-workbench.ts"
      },
      "dependsOn": ["workbench-build"]
    }
  }
}
