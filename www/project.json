{
  "name": "www",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "www/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.next"],
      "options": { "command": "next build", "cwd": "www" },
      "dependsOn": [
        { "projects": ["openai"], "target": "build" },
        "collect-docs",
        "generate-llms"
      ]
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": { "command": "next dev", "cwd": "www" },
      "dependsOn": [
        { "projects": ["openai"], "target": "build" },
        "collect-docs",
        "generate-llms"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --config www/vitest.config.mts" },
      "dependsOn": ["collect-docs", "generate-llms"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint www/src www/test" }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": { "command": "tsx www/src/tools/route-report.ts" },
      "dependsOn": ["build"]
    },
    "collect-docs": {
      "executor": "nx:run-commands",
      "options": { "command": "tsx www/src/tools/extract-docs-content.ts" },
      "dependsOn": [
        { "projects": ["angular", "core", "react"], "target": "build" }
      ]
    },
    "generate-llms": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node www/src/tools/generate-llms.mjs --baseUrl=https://hashbrown.dev"
      }
    },
    "review-docs": {
      "executor": "nx:run-commands",
      "options": { "command": "tsx www/src/tools/review-docs.ts" },
      "dependsOn": [
        {
          "projects": ["angular", "azure", "core", "google", "openai", "react"],
          "target": "build-api-report"
        }
      ]
    },
    "translate-docs": {
      "executor": "nx:run-commands",
      "options": { "command": "tsx www/src/tools/translate-docs.ts" },
      "dependsOn": [
        {
          "projects": ["angular", "azure", "core", "google", "openai", "react"],
          "target": "build-api-report"
        }
      ]
    }
  }
}
