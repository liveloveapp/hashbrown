{
  "name": "www",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "www/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.next"],
      "options": {
        "command": "next build",
        "cwd": "www"
      },
      "dependsOn": [
        {
          "projects": ["openai"],
          "target": "build"
        },
        "collect-docs",
        "generate-llms"
      ],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "env": "VERCEL_GIT_COMMIT_SHA"
        },
        {
          "env": "NODE_ENV"
        },
        {
          "env": "VERCEL_ENV"
        },
        {
          "env": "VERCEL_URL"
        },
        "ciTooling",
        {
          "env": "NEXT_PUBLIC_POSTHOG_TOKEN"
        },
        {
          "env": "NEXT_PUBLIC_POSTHOG_CAPTURE_LOCAL"
        },
        {
          "env": "NEXT_PUBLIC_GROWTH_COLLECTION"
        },
        {
          "env": "VERCEL"
        }
      ]
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "next dev",
        "cwd": "www"
      },
      "dependsOn": [
        {
          "projects": ["openai"],
          "target": "build"
        },
        "collect-docs",
        "generate-llms"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config www/vitest.config.mts"
      },
      "dependsOn": ["collect-docs", "generate-llms"],
      "cache": true,
      "inputs": ["default", "^production", "ciTooling"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint www/src www/test www/instrumentation-client.ts www/next.config.ts www/examples/quickstart www/examples/threadplane-consumers"
      },
      "cache": true,
      "inputs": ["default", "^production", "ciTooling"]
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsx www/src/tools/route-report.ts",
          "tsx www/src/tools/mobile-layout-report.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["build", "workbench-check"]
    },
    "collect-docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx www/src/tools/extract-docs-content.ts"
      },
      "dependsOn": [
        {
          "projects": ["angular", "core", "react"],
          "target": "build"
        }
      ],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "ciTooling",
        "{workspaceRoot}/tsconfig.docs.json"
      ],
      "outputs": [
        "{projectRoot}/content/reference",
        "{workspaceRoot}/dist/reports/angular.api.json",
        "{workspaceRoot}/dist/reports/core.api.json",
        "{workspaceRoot}/dist/reports/react.api.json"
      ]
    },
    "generate-llms": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node www/src/tools/generate-llms.mjs --baseUrl=https://hashbrown.dev"
      },
      "cache": true,
      "inputs": ["default", "^production", "ciTooling"],
      "outputs": [
        "{projectRoot}/public/llms.txt",
        "{projectRoot}/public/llms-full.txt"
      ]
    },
    "review-docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx www/src/tools/review-docs.ts"
      },
      "dependsOn": [
        {
          "projects": [
            "angular",
            "azure",
            "core",
            "google",
            "openai",
            "react",
            "typesafe"
          ],
          "target": "build-api-report"
        }
      ]
    },
    "translate-docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx www/src/tools/translate-docs.ts"
      },
      "dependsOn": [
        {
          "projects": [
            "angular",
            "azure",
            "core",
            "google",
            "openai",
            "react",
            "typesafe"
          ],
          "target": "build-api-report"
        }
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ngc -p www/examples/quickstart/tsconfig.json"
      },
      "dependsOn": [
        {
          "projects": ["core", "react", "angular", "openai", "typesafe"],
          "target": "build"
        }
      ],
      "cache": true,
      "inputs": ["workbench"]
    },
    "docs-demo": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-quickstart.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"],
      "cache": false
    },
    "docs-workflows-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-workflows.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "docs-structured-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-structured.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "docs-production-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-production.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "docs-recipes-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-recipes.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "docs-local-models-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-local-models.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "docs-request-transform-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-request-transform.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "docs-threadplane-prepare": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx www/src/tools/prepare-docs-threadplane.ts"
      }
    },
    "docs-threadplane-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx www/src/tools/record-docs-threadplane.ts"
      }
    },
    "docs-agent-decisions-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-agent-decisions.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "docs-ui-chatbot-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-light-chatbot.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "docs-parser-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/record-docs-parser.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"]
    },
    "workbench-build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/docs-workbench/browser",
        "{workspaceRoot}/dist/docs-workbench/node",
        "{workspaceRoot}/dist/docs-quickstart/compiled"
      ],
      "options": {
        "commands": [
          "ngc -p www/examples/quickstart/tsconfig.record.json",
          "tsx www/src/tools/build-workbench.ts"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck"],
      "cache": true,
      "inputs": ["workbench"]
    },
    "workbench-serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "node --env-file-if-exists=.env dist/docs-workbench/node/workbench-server.mjs"
      },
      "dependsOn": ["workbench-build"]
    },
    "workbench-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node dist/docs-workbench/node/verify-workbench.mjs"
      },
      "dependsOn": ["workbench-build"]
    },
    "workbench-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx www/src/tools/record-workbench.ts"
      },
      "dependsOn": ["workbench-build"]
    },
    "workbench-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["workbench"],
      "outputs": ["{workspaceRoot}/dist/docs-workbench/verification"],
      "dependsOn": ["workbench-build"],
      "options": {
        "command": "node dist/docs-workbench/node/verify-workbench.mjs",
        "env": {
          "WORKBENCH_LIVE": "0",
          "WORKBENCH_RECORD": "0",
          "WORKBENCH_LESSONS": "",
          "WORKBENCH_OUTPUT": "dist/docs-workbench/verification"
        }
      }
    },
    "docs-threadplane-live-demo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx www/src/tools/record-docs-threadplane-live.ts"
      },
      "dependsOn": ["workbench-build"]
    }
  },
  "namedInputs": {
    "workbench": [
      "{workspaceRoot}/www/examples/quickstart/**/*",
      "{workspaceRoot}/www/src/tools/**/*",
      "{workspaceRoot}/www/src/lib/og/fonts/**/*",
      "{workspaceRoot}/packages/{core,react,angular,openai,typesafe}/**/*",
      "{workspaceRoot}/tools/growth/install/**/*",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/.nvmrc",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/eslint.angular.config.mjs"
    ],
    "ciTooling": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/.nvmrc",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/eslint.angular.config.mjs"
    ]
  }
}
