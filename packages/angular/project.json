{
  "name": "angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/src",
  "prefix": "hb",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/packages/angular", "packages/angular"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "preserveLocalDependencyProtocols": false
    }
  },
  "tags": [],
  "targets": {
    "prepare": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/package.json",
        "{workspaceRoot}/tools/growth/install/write-package-version.mjs"
      ],
      "outputs": ["{projectRoot}/src/package-version.ts"],
      "options": {
        "command": "node tools/growth/install/write-package-version.mjs angular"
      },
      "cache": true
    },
    "compile": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/packages/angular"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/angular/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/angular/tsconfig.lib.json"
        }
      },
      "dependsOn": ["^build", "prepare"],
      "inputs": ["production", "^production", "libraryTooling"]
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["compile"],
      "inputs": ["production", "^production", "libraryTooling"],
      "outputs": ["{workspaceRoot}/dist/packages/angular"],
      "options": {
        "command": "node tools/growth/install/assemble-package.mjs angular"
      },
      "cache": true
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["^nx-release-publish"],
      "options": {
        "packageRoot": "dist/packages/angular"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@analogjs/vitest-angular:test",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "runtime": "node --version"
        }
      ]
    },
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["angular"],
          "target": "build"
        }
      ],
      "options": {
        "command": "node --test packages/angular/e2e/package-compatibility.e2e.test.mjs"
      }
    },
    "build-api-report": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["angular"],
          "target": "build"
        }
      ],
      "options": {
        "command": "npx api-extractor run --local --config packages/angular/api-extractor.json",
        "parallel": true
      }
    }
  }
}
