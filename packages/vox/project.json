{
  "name": "vox",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/vox/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/rollup:rollup",
      "outputs": ["{options.outputPath}"],
      "options": {
        "main": "packages/vox/src/index.ts",
        "tsConfig": "packages/vox/tsconfig.lib.json",
        "outputPath": "dist/packages/vox",
        "format": ["esm", "cjs"],
        "outputFileName": "index",
        "rollupConfig": "packages/vox/rollup.config.cjs",
        "generatePackageJson": false,
        "assets": [
          {
            "input": "packages/vox",
            "glob": "*.md",
            "output": "."
          },
          {
            "input": "packages/vox",
            "glob": "package.json",
            "output": "."
          },
          {
            "input": "packages/vox/src/assets",
            "glob": "**/*",
            "output": "assets"
          }
        ],
        "generateExportsField": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/vox/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/vox/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/packages/vox-e2e"],
      "dependsOn": [
        {
          "projects": ["vox"],
          "target": "build"
        }
      ],
      "options": {
        "jestConfig": "packages/vox/jest.e2e.config.ts",
        "passWithNoTests": false
      }
    }
  }
}
