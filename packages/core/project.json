{
  "name": "core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/core/src",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["dist/packages/core", "packages/core"]
    }
  },
  "tags": ["shared"],
  "targets": {
    "compile": {
      "outputs": ["{options.outputPath}"],
      "executor": "@nx/rollup:rollup",
      "options": {
        "main": "packages/core/src/index.ts",
        "tsConfig": "packages/core/tsconfig.lib.json",
        "outputPath": "dist/packages/core",
        "format": ["esm", "cjs"],
        "outputFileName": "index",
        "outputFileExtensionForEsm": ".mjs",
        "outputFileExtensionForCjs": ".cjs",
        "rollupConfig": "packages/core/package-output.config.cjs",
        "sourceMap": true,
        "assets": [
          {
            "input": "packages/core",
            "glob": "LICENSE",
            "output": "."
          },
          {
            "input": "packages/core",
            "glob": "README.md",
            "output": "."
          }
        ],
        "external": ["#development-install"]
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["compile"],
      "inputs": ["production", "^production", "libraryTooling"],
      "outputs": ["{workspaceRoot}/dist/packages/core"],
      "options": {
        "command": "node tools/growth/install/assemble-package.mjs core"
      },
      "cache": true
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/core/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/core/jest.config.ts",
        "passWithNoTests": true
      },
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "runtime": "node --version"
        },
        "{workspaceRoot}/tools/conformance/agent-frameworks/python/evidence/*.sse",
        "{workspaceRoot}/tools/conformance/agent-frameworks/python/evidence/*.request.json"
      ]
    },
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/packages/core-e2e"],
      "dependsOn": [
        {
          "projects": ["core"],
          "target": "build"
        }
      ],
      "options": {
        "jestConfig": "packages/core/jest.e2e.config.ts",
        "passWithNoTests": false
      }
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["^nx-release-publish"],
      "options": {
        "packageRoot": "dist/packages/core"
      }
    },
    "build-api-report": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["core"],
          "target": "build"
        }
      ],
      "options": {
        "command": "npx api-extractor run --local --config packages/core/api-extractor.json",
        "parallel": true
      }
    }
  }
}
