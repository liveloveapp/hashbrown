{
  "name": "@hashbrownai/core",
  "version": "0.8.1",
  "description": "Runtime helpers for Hashbrown AI",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "src/**/*",
    "index*.*",
    "**/*.esm.js",
    "**/*.esm.js.map",
    "**/*.cjs.js",
    "**/*.cjs.js.map",
    "LICENSE",
    "package.json",
    "README.md",
    "install/*.cjs",
    "development-install.*"
  ],
  "imports": {
    "#development-install": {
      "development": {
        "import": "./development-install.mjs",
        "require": "./development-install.cjs",
        "default": "./development-install.mjs"
      },
      "import": "./development-install.null.mjs",
      "require": "./development-install.null.cjs",
      "default": "./development-install.null.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@ag-ui/core": "1.0.3",
    "@cacheplane/json-stream": "0.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "hashbrown",
    "generative-ui",
    "llm",
    "ai",
    "typescript"
  ],
  "homepage": "https://hashbrown.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/liveloveapp/hashbrown.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/liveloveapp/hashbrown/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/liveloveapp"
  }
}
